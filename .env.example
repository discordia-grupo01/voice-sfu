# Puerto del servicio de signaling en tu maquina.
SIGNALING_PORT=4000

# Los valores de ejemplo sirven solo para correr en local.
JWT_SECRET=clave_de_ejemplo_de_al_menos_64_caracteres_de_largo_para_pruebas_locales
SECRET_KEY_BASE=clave_de_ejemplo_de_al_menos_64_caracteres_de_largo_para_pruebas_locales

# URL de LiveKit que ve el servicio y que se les entrega a los clientes. En el
# compose, el LiveKit del propio compose (host.docker.internal es tu maquina).
LIVEKIT_PUBLIC_URL=ws://host.docker.internal:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_TOKEN_TTL_SECONDS=3600

# allow_authenticated: cualquier usuario con JWT puede entrar (solo local).
# En produccion: replica. Tambien existen servers_api y replica_shadow.
VOICE_AUTHZ_MODE=allow_authenticated

# Solo se usa en las llamadas privadas.
MESSAGING_URL=http://host.docker.internal:4000
# Solo con VOICE_AUTHZ_MODE=servers_api.
SERVERS_URL=http://host.docker.internal:8080

# RabbitMQ: se levanta con el repo rabbit-mq. Sin el, el servicio arranca igual
# y reintenta conectarse.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Lo mismo, pero para cuando el servicio corre en el docker compose de este
# repo: desde un contenedor, localhost es el propio contenedor.
#   RABBITMQ_URL_DOCKER=amqp://guest:guest@host.docker.internal:5672/
RABBITMQ_URL_DOCKER=

EVENTS_EXCHANGE=discordia.events
VOICE_EVENTS_QUEUE=voice.signaling
VOICE_INSTANCE_ID=local-signaling-1
ADMIN_EVENTS_HMAC_SECRET=secreto-admin-solo-local

# Base de la replica de autorizacion y del outbox de eventos.
DATABASE_NAME=discordia_voice
DATABASE_USER=discordia
DATABASE_PASSWORD=discordia
DATABASE_PORT=5434
VOICE_REPLICA_DATABASE_URL=postgres://discordia:discordia@localhost:5434/discordia_voice
